# Copy to .env (ignored by Git) if you prefer a shell env file.
# Real values are stored by DSH in ~/.dsh/.credentials.yaml and can also come
# from your shell profile. Never commit a filled-in copy.

# Referenced by the profile's llm-pi-ai provider (opencode-go).
OPENCODE_GO_API_KEY=

# Referenced by DeepSeek's own account/API-key integrations, if used.
DEEPSEEK_API_KEY=

# Optional path overrides (defaults shown).
# DSH_HOME=~/.dsh
# DSH_AGENTS_HOME=~/.agents

# Optional: path to the DSH app bundle, used by `bin/dsh doctor` for version detection.
# DSH_APP="/Applications/DeepSeek Harness.app"
